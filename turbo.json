{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false
    },
    "typecheck": {},
    "test": {
      "cache": false,
      "env": ["TEST_DATABASE_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}
