{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false,
      "env": ["TESTING_DATABASE_URL", "TESTING_REDIS_URL", "TESTING_SESSION_SECRET"]
    },
    "e2e": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
