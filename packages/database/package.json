{
  "name": "@epinfresh/database",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "migrate": "bun --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@epinfresh/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.40.0",
    "drizzle-typebox": "^0.3.0",
    "elysia": "^1.2.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0"
  }
}
