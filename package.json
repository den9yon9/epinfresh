{
  "name": "epinfresh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo migrate && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "eslint . && prettier --check .",
    "clean": "rm -rf apps/*/dist packages/*/dist domains/*/dist apps/*/.turbo packages/*/.turbo domains/*/.turbo",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "lefthook": "^1.11.0",
    "prettier": "^3.9.6",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "bun": ">=1.2"
  }
}
