{
  "name": "epinfresh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo migrate && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome ci .",
    "lint:boundaries": "eslint --ext .ts domains/ packages/ workflows/ apps/",
    "clean": "rm -rf apps/*/dist packages/*/dist domains/*/dist workflows/*/dist apps/*/.turbo packages/*/.turbo domains/*/.turbo workflows/*/.turbo",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/bun": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "lefthook": "^1.11.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "bun": ">=1.2"
  }
}
