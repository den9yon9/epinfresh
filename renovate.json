{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["after 9am and before 6pm every weekday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "patch 依赖 CI 全绿后自动合并",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "minor 升级合并为一个 PR, 降低噪音",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor dependency updates"
    },
    {
      "description": "elysia 生态 major 升级需人工批准: 账本压着一批等 2.0 的债(tech-debt #1/#13/#18/#20), 升级前先核对",
      "matchPackageNames": ["elysia", "/^@elysiajs//"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
