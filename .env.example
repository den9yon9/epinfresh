DATABASE_URL=postgres://epinfresh:epinfresh@localhost:5432/epinfresh
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-this-with-a-random-32-char-secret

# Logging (debug | info | warn | error | silent)
LOG_LEVEL=info

# CORS origin: `*` (any), single origin `https://app.example.com`,
# or comma-separated allowlist `https://a.com,https://b.com`
CORS_ORIGIN=*

# Trust proxy for rate-limiter IP extraction (true | false)
TRUST_PROXY=false

# Admin bootstrap (db:seed) — production 必须显式设置强密码 (>= 12 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# Storefront API
STOREFRONT_PORT=3000

# 运费策略 (storefront-api 结算用)
# SHIPPING_FLAT_FEE: 固定运费(元), '0.00' = 关闭
# FREE_SHIPPING_THRESHOLD: 满额包邮阈值(元, 按商品合计计), 留空 = 不启用包邮
SHIPPING_FLAT_FEE=0.00
FREE_SHIPPING_THRESHOLD=

# 支付网关渠道, 逗号分隔多值 (mock | wechat | alipay; 可多个并存, 如 wechat,alipay)
# mock 是本地无加密快速通道, 真实网关联调指向本地模拟器
PAYMENT_GATEWAY=mock

# 前端候选支付渠道 (storefront-web 构建时注入; 逗号分隔, 默认 mock; 运行时按浏览器 UA 环境过滤)
VITE_PAYMENT_CHANNEL=mock

# --- WeChat Pay APIv3 (仅 PAYMENT_GATEWAY=wechat 时必需; 密钥由 `pnpm keys:pay` 生成) ---
# 渠道端点: 真实 https://api.mch.weixin.qq.com; 联调期指向本地 pay-mock-server http://localhost:8787
WECHAT_API_BASE=http://localhost:8787
WECHAT_MERCHANT_ID=mock-merchant-1
WECHAT_APP_ID=mock-app-1
WECHAT_API_V3_KEY=0123456789abcdef0123456789abcdef
WECHAT_MERCHANT_SERIAL_NO=MOCK-00000000
WECHAT_MERCHANT_PRIVATE_KEY_PATH=keys/merchant_key.pem
WECHAT_PLATFORM_PUBLIC_KEY_PATH=keys/platform_pub.pem
WECHAT_NOTIFY_URL=http://localhost:3000/payments/notify/wechat

# --- 公众号网页授权 + JS-SDK(JSAPI 支付需要; 联调指向 pay-mock-server) ---
WECHAT_OAUTH_BASE=http://localhost:8787
WECHAT_OAUTH_API_BASE=http://localhost:8787
WECHAT_APP_SECRET=mock-app-secret

# --- Alipay (仅 PAYMENT_GATEWAY=alipay 时必需; 复用 pnpm keys:pay 生成的密钥对) ---
# 网关端点: 真实 https://openapi.alipay.com; 联调期指向本地 pay-mock-server http://localhost:8787
ALIPAY_API_BASE=http://localhost:8787
ALIPAY_APP_ID=mock-alipay-app
ALIPAY_APP_PRIVATE_KEY_PATH=keys/merchant_key.pem
ALIPAY_PUBLIC_KEY_PATH=keys/platform_pub.pem
ALIPAY_NOTIFY_URL=http://localhost:3000/payments/notify/alipay

# --- pay-mock-server (本地微信支付模拟器; 无官方沙箱时的 de-facto 沙箱) ---
PAY_MOCK_PORT=8787
PAY_MOCK_MERCHANT_ID=mock-merchant-1
PAY_MOCK_APP_ID=mock-app-1
PAY_MOCK_API_V3_KEY=0123456789abcdef0123456789abcdef
PAY_MOCK_MERCHANT_PRIVATE_KEY_PATH=keys/merchant_key.pem
PAY_MOCK_PLATFORM_PRIVATE_KEY_PATH=keys/platform_key.pem
PAY_MOCK_PLATFORM_SERIAL_NO=MOCK-00000000
PAY_MOCK_NOTIFY_URL=http://localhost:3000/payments/notify/wechat
# 支付宝模拟器 AppID(与网关侧 ALIPAY_APP_ID 对应; 密钥复用上面商户/平台 PEM)
PAY_MOCK_ALIPAY_APP_ID=mock-alipay-app

# admin API
ADMIN_PORT=3001

# --- 邮件 (worker 消费 email 队列; console 只打日志, 开发默认) ---
# console | smtp; smtp 模式下以下 SMTP_*/MAIL_FROM 全部必填
MAIL_TRANSPORT=console
# 示例(阿里云邮件推送 DirectMail): smtpdm.aliyun.com 465 / 80
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_USER=sender@mail.example.com
# SMTP_PASS=your-smtp-password
# MAIL_FROM=epinfresh <sender@mail.example.com>
# 找回密码邮件重置链接指向 storefront-web
STOREFRONT_WEB_URL=http://localhost:5173

# --- 认证限流 (storefront-api / admin-api, 注册+登录共用) ---
# 次/分钟, 默认 20 为生产风控口径; e2e 由 playwright webServer 行内 env 注入 40
# AUTH_RATE_LIMIT_PER_MINUTE=20

# --- 物流轨迹 (worker 轮询承运商拉取, 签收自动完成订单) ---
# 轨迹来源: mock = 本地沙箱(按时间生成事件) | kuaidi100 = 真实聚合查询(待接入, 注册表已留位)
LOGISTICS_PROVIDER=mock
# mock 轨迹从发货到签收的时长(分钟); 0 = 发货即签收(e2e 演示用)
LOGISTICS_MOCK_DELIVER_AFTER_MINUTES=180
# 轨迹轮询间隔(ms), 默认 10 分钟; 本地想快速看轨迹推进可调小(如 5000)
LOGISTICS_POLL_INTERVAL_MS=600000
# 可选: worker 健康检查 HTTP 端口(设了才起 /health 端点; 容器健康检查与 e2e 就绪探测用)
# HEALTH_PORT=3100

# Testing 流程基建（testing 流程配置，与 test 环境无关；getTestEnv() fail-fast 读取，跑 pnpm test 需要）
TESTING_DATABASE_URL=postgres://epinfresh:epinfresh@localhost:5432/epinfresh_test
TESTING_REDIS_URL=redis://localhost:6379/1
TESTING_SESSION_SECRET=test-session-secret-0123456789abcdef
